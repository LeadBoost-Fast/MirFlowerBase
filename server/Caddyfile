# HTTPS сертификат Caddy получает сам для домена из .env (DOMAIN должен указывать на IP сервера).
{$DOMAIN} {
	encode zstd gzip
	root * /srv/site
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Этап 1: reverse_proxy /api/* app:3000
}
