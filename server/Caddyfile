# HTTPS сертификат Caddy получает сам для домена из .env (DOMAIN должен указывать на IP сервера).
{$DOMAIN} {
	encode zstd gzip
	root * /srv/site

	# Файлы сайта с хэшем в имени и иконки не меняются: телефон хранит их год
	@static path /assets/* /icon-*.png
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Страницы, настройки магазина, подгружаемые разделы и сервис-воркер проверяются при каждом открытии
	@fresh path / /*.html /shop.config.js /manifest.json /firebase-messaging-sw.js /d-*.js /site-version.txt
	header @fresh Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Для мониторинга: открыть /health, должно ответить ok
	respond /health "ok" 200

	file_server
	# Этап 1: reverse_proxy /api/* app:3000
}
