rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Владелец (tilegen615@gmail.com) и главный админ (nash0082008@icloud.com)
    function ownerMail() { return 'tilegen615@gmail.com'; }
    function headMail()  { return 'nash0082008@icloud.com'; }
    function isTopMail(m) { return m.lower() == headMail() || m.lower() == ownerMail(); }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().active == true;
    }
    function role()      { return staffDoc().role; }
    // что сотрудник может без запроса (ставит владелец или админ в «Доступ»)
    function abil(k)     { return isActive() && staffDoc().get('abil', {}).get(k, false) == true; }
    // Владелец и главный админ: финансы, настройки, точки, всё
    function isOwner()   { return isActive() && (request.auth.token.email != null
                           && isTopMail(request.auth.token.email)); }
    // Обычный админ: работники, график, контроль качества, работа как оператор/флорист
    function isAdmin()   { return isActive() && role() == 'admin'; }
    function isMgr()     { return isActive() && role() in ['admin','operator','florist','assistant']; }
    function isWork()    { return isActive() && role() in ['admin','operator','florist','assistant']; }
    // Оператор, флорист, помощник флориста, админ: оплата, приёмка, переделка, чаты, шаблоны (равные права)
    // Доступ сотрудникам: админ и владелец могут закрыть раздел отдельному сотруднику (staff/{uid}.perms: {chats:false, crm:false}).
    // По умолчанию всё открыто, как у роли. Закрывается чтение чатов (chats) и клиентов, заявок, сделок (crm); писать в чаты, как и раньше,
    // могут все рабочие роли: туда уходят фото готового букета и ссылка на статус из заказа.
    function perm(k)     { return staffDoc().get('perms', {}).get(k, true) != false; }
    function canCrm()    { return isAdmin() || isOwner() || (isMgr() && perm('crm')); }
    function canChats()  { return isAdmin() || isOwner() || (isMgr() && perm('chats')); }
    function isOpRole()  { return isActive() && role() in ['admin','operator','florist','assistant']; }
    function isCourier() { return isActive() && role() == 'courier'; }

    // Сотрудники. Обычный админ управляет только не-админами, владельца и главного админа тронуть нельзя
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isActive());
      allow list: if isActive();
      allow create: if isOwner() || (isAdmin()
        && !isTopMail(request.resource.data.get('email',''))
        && request.resource.data.role != 'admin');
      allow update: if isOwner() || (isAdmin()
        && !isTopMail(resource.data.get('email',''))
        && resource.data.role != 'admin'
        && request.resource.data.role != 'admin');
      allow delete: if isOwner() || (isAdmin()
        && !isTopMail(resource.data.get('email',''))
        && resource.data.role != 'admin');
    }

    // Расстановка главной: у каждого своя (id = uid); владелец и админ могут править любую (расстановки ролей)
    match /layouts/{id} {
      allow read: if isActive();
      allow create, update, delete: if isActive() && (id == request.auth.uid || isOwner() || isAdmin());
    }

    match /presence/{uid} {
      allow read: if isActive();
      allow write: if isActive() && request.auth.uid == uid;
    }

    // Заказы: кто что отметил. Записывать можно только себя: оплату (paidBy), приёмку (accBy), сборку (asm),
    // взятие в работу (takenBy). «Готов» на заказе, который взял другой флорист, и приёмку своего же заказа
    // отмечают только админ и владельцы (то же проверяет сайт). Пустая строка — сброс при переделке.
    function setsSelfOrEmpty(d, k, f) {
      return !k.hasAny([f]) || d.get(f, '') == '' || d.get(f, '') == request.auth.uid;
    }
    function orderMarksOk() {
      let d = request.resource.data;
      let r = resource.data;
      let k = d.diff(r).affectedKeys();
      let boss = isAdmin() || isOwner();
      return setsSelfOrEmpty(d, k, 'paidBy')
        && setsSelfOrEmpty(d, k, 'accBy')
        && setsSelfOrEmpty(d, k, 'asm')
        // проверку оплаты (подтвердить / не принять) ставят только админ и владелец
        && (!k.hasAny(['pvSt','pvSig','pvBy','pvAt','pvNote']) || boss || abil('pvOk'))
        // взять в работу: свободный/новый заказ или передача, адресованная мне
        && (!k.hasAny(['takenBy']) || boss
            || (d.takenBy == request.auth.uid
                && (r.get('st', 0) == 0 || r.get('takenBy', '') == '' || r.get('xfTo', '') == request.auth.uid)))
        // «Готов» (asm = я) на заказе другого флориста
        && (!k.hasAny(['asm']) || d.get('asm', '') == '' || boss
            || r.get('takenBy', '') == '' || r.get('takenBy', '') == request.auth.uid)
        // приёмка своего заказа (rv: wait → ok)
        && (!(k.hasAny(['rv']) && d.get('rv', '') == 'ok' && r.get('rv', '') == 'wait') || boss
            || r.get('asm', '') != request.auth.uid)
        // отмена и снижение цены — сам сотрудник только отправляет запрос (rqK); разрешает или отклоняет
        // любой другой сотрудник (не автор запроса; курьер сюда не попадает — у него своя ветка), админ или владелец
        && (((!(k.hasAny(['st']) && d.get('st', 0) == 5 && r.get('st', 0) != 5) || abil('cancel'))
             && (!(k.hasAny(['p']) && d.get('p', 0) < r.get('p', 0)) || abil('disc'))
             && !(k.hasAny(['rqK']) && d.get('rqBy', '') != request.auth.uid)) || boss
            || (r.get('rqK', '') != '' && r.get('rqBy', '') != request.auth.uid && d.get('rqK', '') == ''
                && (!(k.hasAny(['st']) && d.get('st', 0) == 5 && r.get('st', 0) != 5) || r.get('rqK', '') == 'cx')
                && (!(k.hasAny(['p']) && d.get('p', 0) < r.get('p', 0)) || (r.get('rqK', '') == 'p' && d.get('p', 0) == r.get('rqP', 0)))));
    }

    match /orders/{id} {
      // Курьер читает заказы (в интерфейсе показываем только доставки: свои и свободные)
      allow read: if isWork() || isCourier();
      allow create: if isMgr() && (request.resource.data.get('paid', false) != true || isOpRole())
        && (!('pvSt' in request.resource.data) || isAdmin() || isOwner())
        && request.resource.data.get('by', request.auth.uid) == request.auth.uid
        && request.resource.data.get('paidBy', request.auth.uid) == request.auth.uid;
      allow update: if (isWork() && orderMarksOk()
          && (isOpRole() || !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['paid','paidAt','paidBy','accBy','accAt','redoN','redoAt','redoBy','redoNote']))) ||
        // Курьер отмечает доставку с фото
        (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st == 3
          && resource.data.get('cAcc', 0) > 0
          && request.resource.data.st == 4
          && request.resource.data.proof is string
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['st','updatedAt','statusBy','proof','doneAt','chk','chkBy','chkAt']))
        // Курьер правит только чек
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [3,4]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['chk','chkBy','chkAt','updatedAt']))
        // Любой курьер берёт свободный заказ на доставку (статус не меняется)
        || (isCourier()
          && resource.data.dv == true
          && (!('courier' in resource.data) || resource.data.courier == null || resource.data.courier == '')
          && resource.data.st in [0, 1, 2, 3]
          && request.resource.data.courier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['courier','cAcc','cBy','updatedAt','statusBy','shipAt']))
        // Курьер забрал готовый букет: «Готов» → «В пути»
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.get('cAcc', 0) > 0
          && resource.data.st == 2 && request.resource.data.st == 3
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['st','shipAt','updatedAt','statusBy']))
        // Курьер подтверждает назначенную ему доставку
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [1, 2, 3]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['cAcc','cBy','updatedAt','statusBy']))
        // Курьер отказывается от своей доставки (заказ становится свободным)
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [1, 2, 3]
          && request.resource.data.courier == ''
          && (request.resource.data.st == resource.data.st || (resource.data.st == 3 && request.resource.data.st == 2))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['courier','cAcc','cBy','cRelAt','cRelBy','cRelNote','updatedAt','statusBy','st']));
      allow delete: if isAdmin() || isOwner();
    }

    // Позиции склада: все рабочие роли двигают остатки (приход, списание, сборка, возврат): qty, qs (остаток по точкам), lt (партии),
    // recv; фото, срок хранения и поставщика тоже можно. Название, категорию, единицу, цену продажи и минимальный остаток
    // меняют только админ и владелец (сотрудник отправляет запрос, kind ed в stockReqs)
    match /inventory/{id} {
      allow read, create: if isWork();
      allow update: if isAdmin() || isOwner() || (isWork() && abil('stockEdit'))
        || (isWork() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['qty','qs','lt','recv','updatedAt','img','shelf','sup','pkOpen','pkHist','pkAuto']));
      allow delete: if isAdmin() || isOwner();
    }
    match /invcost/{id}         { allow read, write: if isOwner(); }
    // История склада: только добавлять. Удалить запись может только владелец (чтобы списание нельзя было стереть)
    match /stockMovements/{id} {
      allow read, create: if isWork();
      allow update: if false;
      allow delete: if isOwner();
    }
    // Каталог букетов: удалять могут админы, владельцы, флористы и помощники флориста
    match /bouquets/{id}        { allow read, create, update: if isMgr(); allow delete: if isAdmin() || isOwner() || (isActive() && role() in ['florist','assistant']); }
    match /stockReqs/{id}       { allow read: if isActive(); allow create: if isActive() && request.resource.data.uid == request.auth.uid; allow update, delete: if isAdmin() || isOwner(); }
    // Галерея: цену и состав меняют только админ и владелец (сотрудник отправляет запрос, kind gal в stockReqs)
    match /gallery/{id}         { allow read: if isWork(); allow create: if isWork() && request.resource.data.by == request.auth.uid; allow update: if isAdmin() || isOwner(); allow delete: if isMgr() || isAdmin() || isOwner(); }
    match /showcase/{id}        { allow read, create, update: if isWork(); allow delete: if isAdmin() || isOwner(); }
    match /visits/{id}          { allow read, create, update: if isWork(); allow delete: if isAdmin() || isOwner(); }

    // Сборки букетов (для статистики сотрудников)
    match /builds/{id} {
      allow read: if isAdmin() || isOwner() || (isWork() && resource.data.by == request.auth.uid);
      allow create: if isWork() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || isOwner();
    }

    // Отчёты сотрудников (фото витрины, рабочего места, смена оператора)
    // Отметка «отчёт по точке сдан» (рабочее место, витрина): видят все сотрудники, кто сдал — без фото
    match /rpDone/{id} {
      allow read: if isWork();
      allow create, update: if isWork() && request.resource.data.by == request.auth.uid;
      allow delete: if isAdmin() || isOwner();
    }
    match /reports/{id} {
      allow read: if isAdmin() || isOwner() || abil('woOk') || (isWork() && resource.data.by == request.auth.uid);
      allow create: if isWork() && request.resource.data.by == request.auth.uid;
      allow update: if isAdmin() || isOwner() || (isWork() && abil('woOk'));
      allow delete: if isAdmin() || isOwner();
    }

    match /customers/{id}       { allow read, create, update: if canCrm(); allow delete: if isAdmin() || isOwner(); }
    match /leads/{id}           { allow read, create, update: if canCrm(); allow delete: if isAdmin() || isOwner(); }
    match /deals/{id} {
      allow read, create, update: if canCrm();
      allow delete: if isAdmin() || isOwner();
    }

    // Подписки на цветы (регулярные букеты): ведёт тот, у кого есть доступ к клиентам
    match /subs/{id} {
      allow read, create, update: if canCrm();
      allow delete: if isAdmin() || isOwner();
    }

    match /chats/{id} {
      allow read: if canChats();
      allow create, update: if isMgr();
      allow delete: if isAdmin() || isOwner();
      match /msgs/{mid} {
        allow read: if canChats();
        allow create, update: if isMgr();
        allow delete: if isAdmin() || isOwner();
      }
    }

    match /team/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner();
    }

    // Финансы: только владелец и главный админ
    match /expenses/{id}        { allow read, write: if isOwner(); }

    match /shifts/{id}          { allow read: if isActive(); allow write: if isAdmin() || isOwner(); }
    // Заявки на смену: сотрудник создаёт свою, админ принимает/отклоняет
    match /shiftRequests/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid','date','t','by','byName','ts','st']);
      allow update: if isAdmin() || isOwner();
      // свою ожидающую заявку сотрудник может заменить новой
      allow delete: if isAdmin() || isOwner() || (isActive() && resource.data.uid == request.auth.uid && resource.data.st == 'wait');
    }
    // Фактические смены (кнопки «Начать / Закончить смену» на главной)
    // Начать смену можно только сейчас (±30 мин), не задним числом: от смен зависит оплата. Сотрудник не меняет начало своей смены,
    // закрытую смену не меняет, конец ставит не позже текущего времени. Исправления делают админ и владелец (их видно в журнале на сервере)
    function nowMs() { return request.time.toMillis(); }
    match /shiftLog/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid
        && (isAdmin() || isOwner() || (request.resource.data.start is number
            && request.resource.data.start > nowMs() - 1800000 && request.resource.data.start < nowMs() + 1800000));
      allow update: if isActive() && request.resource.data.uid == resource.data.uid
        && (isAdmin() || isOwner()
            || (resource.data.uid == request.auth.uid
                && request.resource.data.get('start', 0) == resource.data.get('start', 0)
                && (resource.data.get('end', 0) == 0 || request.resource.data.get('end', 0) == resource.data.get('end', 0))
                && request.resource.data.get('end', 0) <= nowMs() + 1800000
                && (request.resource.data.get('end', 0) == 0 || request.resource.data.get('end', 0) >= request.resource.data.get('start', 0))));
      allow delete: if isOwner();
    }
    // Точки: создавать и менять могут владелец и админ (техническая настройка), удалять только владелец
    match /locations/{id}       { allow read: if isActive(); allow create, update: if isOwner() || isAdmin(); allow delete: if isOwner(); }
    // Настройки магазина. Владелец и главный админ: всё. Обычный админ: все технические настройки (магазин, функции, точки, каналы связи,
    // сообщения клиентам, витрина), но не деньги: ставки сотрудников (pay), бонусы клиентам (bonus), наценки оплаты (payRed, payRas),
    // отсечка финансов (finFrom*). Шаблоны чата (tpls) могут менять все, кроме курьера.
    match /settings/{id} {
      allow read: if isActive();
      allow write: if isOwner()
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pay','bonus','payRed','payRas','finFrom','finFromBy','finFromByName']))
        || (isActive() && role() in ['operator','florist','assistant']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tpls','updatedAt']));
    }

    // Push-токены устройств: каждый сотрудник управляет только своими (читает и шлёт сервер)
    match /pushTokens/{id} {
      allow read, delete: if isActive() && resource.data.uid == request.auth.uid;
      allow create, update: if isActive() && request.resource.data.uid == request.auth.uid;
    }

    // Онлайн-витрина (страница vitrina.html для клиентов): один документ pubShop/main, читать может кто угодно по адресу.
    // Настройки, список фото и отзывы пишут владелец и админ. Здесь нет персональных данных.
    // Заявки с каталога для клиентов (vitrina.html): создать может любой посетитель, только эти поля и короткие;
    // читать и разбирать — сотрудники с доступом к клиентам. Сайт сам переносит их в «Заявки» / «Воронку».
    match /webLeads/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','item','iid','price','date','time','dv','addr','wish','st','ts'])
        && request.resource.data.st == 'new'
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.item is string && request.resource.data.item.size() <= 80
        && request.resource.data.iid is string && request.resource.data.iid.size() <= 40
        && request.resource.data.addr is string && request.resource.data.addr.size() <= 160
        && request.resource.data.wish is string && request.resource.data.wish.size() <= 400
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.time is string && request.resource.data.time.size() <= 5
        && request.resource.data.price is int && request.resource.data.dv is bool && request.resource.data.ts is int;
      allow read, update: if canCrm();
      allow delete: if isAdmin() || isOwner();
    }
    match /pubShop/{id} {
      allow get: if true;
      allow create, update: if (isOwner() || isAdmin())
        && (!('items' in request.resource.data) || request.resource.data.items.size() <= 150);
      allow delete: if isOwner();
    }

    // Публичный статус заказа для клиента: читать документ по токену может любой, список нельзя, писать только сотрудники
    match /pubOrders/{tok} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isWork();
    }

    // Оценка заказа клиентом со страницы статуса: одна на заказ, только когда заказ выдан/доставлен
    match /reviews/{tok} {
      allow get: if true;
      allow list: if isWork();
      allow create: if tok.matches('^[a-f0-9]{24}$')
        && exists(/databases/$(database)/documents/pubOrders/$(tok))
        && get(/databases/$(database)/documents/pubOrders/$(tok)).data.st == 4
        && request.resource.data.keys().hasOnly(['s','c'])
        && request.resource.data.s is int && request.resource.data.s >= 1 && request.resource.data.s <= 5
        && (!('c' in request.resource.data) || (request.resource.data.c is string && request.resource.data.c.size() <= 500));
      allow update, delete: if false;
    }

    // Ключи каналов связи (WhatsApp, Instagram, Telegram): пишут владелец и админ (подключение каналов), с сайта читать нельзя, читает сервер
    match /secrets/{id} {
      allow write: if isOwner() || isAdmin();
      allow read: if false;
    }

    // Журнал действий: удалить запись может только владелец (админ свои действия стереть не может)
    match /activityLogs/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isAdmin() || isOwner();
      allow update: if false;
      allow delete: if isOwner();
    }

    // Журнал изменений на сервере: пишет только функция (audit*), с сайта ни создать, ни изменить, ни удалить
    // Задачи на смену: сотрудник пишет только свои отметки (документ {uid}_{день}); читают сам сотрудник, админ и владелец
    match /checks/{id} {
      allow read: if isAdmin() || isOwner() || (isActive() && id.matches(request.auth.uid + '_.*'));
      allow create, update: if isActive() && id.matches(request.auth.uid + '_.*') && request.resource.data.uid == request.auth.uid;
      allow delete: if isOwner();
    }
    match /audit/{id} {
      allow read: if isAdmin() || isOwner();
      allow write: if false;
    }
  }
}
