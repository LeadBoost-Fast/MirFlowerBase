rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Владелец (tilegen615@gmail.com) и главный админ (nash0082008@icloud.com)
    function ownerMail() { return 'tilegen615@gmail.com'; }
    function headMail()  { return 'nash0082008@icloud.com'; }
    function isTopMail(m) { return m.lower() == headMail() || m.lower() == ownerMail(); }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && staffDoc().active == true;
    }
    function role()      { return staffDoc().role; }
    // Владелец и главный админ: финансы, настройки, точки, всё
    function isOwner()   { return isActive() && (request.auth.token.email != null
                           && isTopMail(request.auth.token.email)); }
    // Обычный админ: работники, график, контроль качества, работа как оператор/флорист
    function isAdmin()   { return isActive() && role() == 'admin'; }
    function isMgr()     { return isActive() && role() in ['admin','operator','florist','assistant']; }
    function isWork()    { return isActive() && role() in ['admin','operator','florist','assistant']; }
    // Оператор, флорист, помощник флориста, админ: оплата, приёмка, переделка, чаты, шаблоны (равные права)
    function isOpRole()  { return isActive() && role() in ['admin','operator','florist','assistant']; }
    function isCourier() { return isActive() && role() == 'courier'; }

    // Сотрудники. Обычный админ управляет только не-админами, владельца и главного админа тронуть нельзя
    match /staff/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isActive());
      allow list: if isActive();
      allow create: if isOwner() || (isAdmin()
        && !isTopMail(request.resource.data.get('email',''))
        && request.resource.data.role != 'admin');
      allow update: if isOwner() || (isAdmin()
        && !isTopMail(resource.data.get('email',''))
        && resource.data.role != 'admin'
        && request.resource.data.role != 'admin');
      allow delete: if isOwner() || (isAdmin()
        && !isTopMail(resource.data.get('email',''))
        && resource.data.role != 'admin');
    }

    match /presence/{uid} {
      allow read: if isActive();
      allow write: if isActive() && request.auth.uid == uid;
    }

    // Заказы: кто что отметил. Записывать можно только себя: оплату (paidBy), приёмку (accBy), сборку (asm),
    // взятие в работу (takenBy). «Готов» на заказе, который взял другой флорист, и приёмку своего же заказа
    // отмечают только админ и владельцы (то же проверяет сайт). Пустая строка — сброс при переделке.
    function setsSelfOrEmpty(d, k, f) {
      return !k.hasAny([f]) || d.get(f, '') == '' || d.get(f, '') == request.auth.uid;
    }
    function orderMarksOk() {
      let d = request.resource.data;
      let r = resource.data;
      let k = d.diff(r).affectedKeys();
      let boss = isAdmin() || isOwner();
      return setsSelfOrEmpty(d, k, 'paidBy')
        && setsSelfOrEmpty(d, k, 'accBy')
        && setsSelfOrEmpty(d, k, 'asm')
        // взять в работу: свободный/новый заказ или передача, адресованная мне
        && (!k.hasAny(['takenBy']) || boss
            || (d.takenBy == request.auth.uid
                && (r.get('st', 0) == 0 || r.get('takenBy', '') == '' || r.get('xfTo', '') == request.auth.uid)))
        // «Готов» (asm = я) на заказе другого флориста
        && (!k.hasAny(['asm']) || d.get('asm', '') == '' || boss
            || r.get('takenBy', '') == '' || r.get('takenBy', '') == request.auth.uid)
        // приёмка своего заказа (rv: wait → ok)
        && (!(k.hasAny(['rv']) && d.get('rv', '') == 'ok' && r.get('rv', '') == 'wait') || boss
            || r.get('asm', '') != request.auth.uid)
        // отмена и снижение цены — только админ/владелец; остальные отправляют запрос (rqK)
        && ((!(k.hasAny(['st']) && d.get('st', 0) == 5 && r.get('st', 0) != 5)
             && !(k.hasAny(['p']) && d.get('p', 0) < r.get('p', 0))
             && !(k.hasAny(['rqK']) && d.get('rqBy', '') != request.auth.uid)) || boss);
    }

    match /orders/{id} {
      // Курьер читает заказы (в интерфейсе показываем только доставки: свои и свободные)
      allow read: if isWork() || isCourier();
      allow create: if isMgr() && (request.resource.data.get('paid', false) != true || isOpRole())
        && request.resource.data.get('by', request.auth.uid) == request.auth.uid
        && request.resource.data.get('paidBy', request.auth.uid) == request.auth.uid;
      allow update: if (isWork() && orderMarksOk()
          && (isOpRole() || !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['paid','paidAt','paidBy','accBy','accAt','redoN','redoAt','redoBy','redoNote']))) ||
        // Курьер отмечает доставку с фото
        (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st == 3
          && resource.data.get('cAcc', 0) > 0
          && request.resource.data.st == 4
          && request.resource.data.proof is string
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['st','updatedAt','statusBy','proof','doneAt','chk','chkBy','chkAt']))
        // Курьер правит только чек
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [3,4]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['chk','chkBy','chkAt','updatedAt']))
        // Любой курьер берёт свободный заказ на доставку (статус не меняется)
        || (isCourier()
          && resource.data.dv == true
          && (!('courier' in resource.data) || resource.data.courier == null || resource.data.courier == '')
          && resource.data.st in [1, 2, 3]
          && request.resource.data.courier == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['courier','cAcc','cBy','updatedAt','statusBy','shipAt']))
        // Курьер подтверждает назначенную ему доставку
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [1, 2, 3]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['cAcc','cBy','updatedAt','statusBy']))
        // Курьер отказывается от своей доставки (заказ становится свободным)
        || (isCourier() && resource.data.courier == request.auth.uid
          && resource.data.st in [1, 2, 3]
          && request.resource.data.courier == ''
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['courier','cAcc','cBy','cRelAt','cRelBy','cRelNote','updatedAt','statusBy']));
      allow delete: if isAdmin() || isOwner();
    }

    match /inventory/{id}       { allow read, create, update: if isWork(); allow delete: if isAdmin() || isOwner(); }
    match /invcost/{id}         { allow read, write: if isOwner(); }
    match /stockMovements/{id} {
      allow read, create: if isWork();
      allow update: if false;
      allow delete: if isAdmin() || isOwner();
    }
    // Каталог букетов: удалять могут админы, владельцы, флористы и помощники флориста
    match /bouquets/{id}        { allow read, create, update: if isMgr(); allow delete: if isAdmin() || isOwner() || (isActive() && role() in ['florist','assistant']); }
    match /showcase/{id}        { allow read, create, update: if isWork(); allow delete: if isAdmin() || isOwner(); }
    match /visits/{id}          { allow read, create, update: if isWork(); allow delete: if isAdmin() || isOwner(); }

    // Сборки букетов (для статистики сотрудников)
    match /builds/{id} {
      allow read: if isAdmin() || isOwner() || (isWork() && resource.data.by == request.auth.uid);
      allow create: if isWork() && request.resource.data.by == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin() || isOwner();
    }

    // Отчёты сотрудников (фото витрины, рабочего места, смена оператора)
    match /reports/{id} {
      allow read: if isAdmin() || isOwner() || (isWork() && resource.data.by == request.auth.uid);
      allow create: if isWork() && request.resource.data.by == request.auth.uid;
      allow update: if isAdmin() || isOwner();
      allow delete: if isAdmin() || isOwner();
    }

    match /customers/{id}       { allow read, create, update: if isMgr(); allow delete: if isAdmin() || isOwner(); }
    match /leads/{id}           { allow read, create, update: if isMgr(); allow delete: if isAdmin() || isOwner(); }
    match /deals/{id} {
      allow read, create, update: if isMgr();
      allow delete: if isAdmin() || isOwner();
    }

    match /chats/{id} {
      allow read, create, update: if isMgr();
      allow delete: if isAdmin() || isOwner();
      match /msgs/{mid} {
        allow read, create, update: if isMgr();
        allow delete: if isAdmin() || isOwner();
      }
    }

    match /team/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow update, delete: if isAdmin() || isOwner();
    }

    // Финансы: только владелец и главный админ
    match /expenses/{id}        { allow read, write: if isOwner(); }

    match /shifts/{id}          { allow read: if isActive(); allow write: if isAdmin() || isOwner(); }
    // Заявки на смену: сотрудник создаёт свою, админ принимает/отклоняет
    match /shiftRequests/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid','date','t','by','byName','ts','st']);
      allow update: if isAdmin() || isOwner();
      // свою ожидающую заявку сотрудник может заменить новой
      allow delete: if isAdmin() || isOwner() || (isActive() && resource.data.uid == request.auth.uid && resource.data.st == 'wait');
    }
    // Фактические смены (кнопки «Начать / Закончить смену» на главной)
    match /shiftLog/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if isActive() && (resource.data.uid == request.auth.uid || isAdmin() || isOwner())
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner();
    }
    match /locations/{id}       { allow read: if isActive(); allow write: if isOwner(); }
    // Настройки магазина: владелец/главный админ; шаблоны чата (tpls) могут менять все, кроме курьера
    match /settings/{id} {
      allow read: if isActive();
      allow write: if isOwner() || (isActive() && role() in ['admin','operator','florist','assistant']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tpls','updatedAt']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statsFrom','statsFromBy','statsFromByName','updatedAt']));
    }

    // Push-токены устройств: каждый сотрудник управляет только своими (читает и шлёт сервер)
    match /pushTokens/{id} {
      allow read, delete: if isActive() && resource.data.uid == request.auth.uid;
      allow create, update: if isActive() && request.resource.data.uid == request.auth.uid;
    }

    // Публичный статус заказа для клиента: читать документ по токену может любой, список нельзя, писать только сотрудники
    match /pubOrders/{tok} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isWork();
    }

    // Ключи каналов связи (WhatsApp, Instagram, Telegram): пишет только владелец, с сайта читать нельзя, читает сервер
    match /secrets/{id} {
      allow write: if isOwner();
      allow read: if false;
    }

    match /activityLogs/{id} {
      allow create: if isActive() && request.resource.data.by == request.auth.uid;
      allow read: if isAdmin() || isOwner();
      allow update: if false;
      allow delete: if isAdmin() || isOwner();
    }
  }
}
