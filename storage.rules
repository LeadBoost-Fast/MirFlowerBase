rules_version = '2';
// Хранилище фото. Сайт кладёт фото заказов, чеков и отчётов в папку orders/.
// Ссылки на фото (getDownloadURL) работают по токену в адресе, поэтому клиент видит фото на странице статуса без входа.
// Папку backups/ пишет только сервер (автокопия), из сайта её не прочитать.
service firebase.storage {
  match /b/{bucket}/o {
    match /orders/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
    match /{all=**} {
      allow read, write: if false;
    }
  }
}
